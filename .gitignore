! .gitignore
__pycache__/
*.pyc
*.pyo
kaggle.json
.ipynb_checkpoints/
tmp/
.vscode/
*.zip

# Local Kaggle-fetch cache (raw src/ snapshots + checkpoint pickles). Not
# covered by .gitattributes' output/** LFS filter, so it must never be
# committed as plain blobs; curate what's worth keeping into output/ instead.
output_remote/
kaggle_logs/
# Python / tooling
.venv*/
.pytest_cache/
.ruff_cache/
*.egg-info/
.env
